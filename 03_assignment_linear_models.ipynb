    "# 2.2\n",
    "from sklearn.linear_model import LinearRegression\n",
    "dfQ12 = dfQ1.loc[:, ['Price','Review Scores Rating', 'Neighbourhood ', 'Property Type','Room Type'] ].dropna() # Filter, drop missing values\n",
    "y = dfQ12['Price'] # Select target/outcome\n",
    "X = pd.get_dummies(dfQ12['Neighbourhood '], dtype=int, drop_first=True) # Select features/covariances\n",
    "\n",
    "model2 = LinearRegression()\n",
    "model2 = model2.fit(X, y)\n",
    "\n",
    "# Print coefficients:\n",
    "print(f'Model intercept: {model2.intercept_}')\n",
    "pd.DataFrame({'variable':model2.feature_names_in_, 'coefficient':model2.coef_ })\n",
    "\n",
    "# The intercept is the mean price for bronx with all the other coefficients (neighborhoods) are differences\n",
    "# between neighborhood's mean price and the Bronx mean. \n",
    "# The conditional group means and the estimated coefficients related that adding the coefficient to \n",
    "# the intercept gives the conditional mean price for that neighbourhood, which matches the group means calculated in part 1."
