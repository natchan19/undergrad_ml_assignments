    "    for train_idx, test_idx in kf.split(X33):\n",
    "        X_train, X_test = X33.iloc[train_idx], X33.iloc[test_idx]\n",
    "        y_train, y_test = y33.iloc[train_idx], y33.iloc[test_idx]\n",
    "\n",
    "        poly = PolynomialFeatures(degree=d, include_bias=False)\n",
    "        X_train_poly = poly.fit_transform(X_train)\n",
    "        X_test_poly = poly.transform(X_test)\n",
    "\n",
    "        model33 = LinearRegression()\n",
    "        model33.fit(X_train_poly, y_train)\n",
    "        y_hat = model33.predict(X_test_poly)\n",
    "\n",
    "        score = mean_squared_error(y_test, y_hat)\n",
    "        scores.append(score)\n",
    "\n",
    "    mean_scores.append(np.mean(scores))\n",
    "    print(\"Degree:\", d, \"Mean score:\", np.mean(scores))\n",
    "\n",
    "best_degree = np.argmin(mean_scores) + 1\n",
    "print(\"Optimal number of powers of Age:\", best_degree)"
   ]
  },
